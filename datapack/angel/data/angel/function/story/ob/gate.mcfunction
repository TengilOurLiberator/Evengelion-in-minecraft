scoreboard players set #ob.vis angel.story 0
execute if score #ob.sn angel.story >= #ob.stillt angel.story run scoreboard players set #ob.vis angel.story 1
execute if score #ob.b angel.story matches 6..30 run scoreboard players set #ob.vis angel.story 1
execute if score #ob.mv angel.story matches 1 run scoreboard players set #stk angel.story 0
